  <description>Waypoint patrol, image recording and optional speech for FishBot.</description>
  <maintainer email="141168900+addrun@users.noreply.github.com">addrun</maintainer>
  <license>Apache-2.0</license>
  <export>
    <build_type>ament_python</build_type>
  </export>
