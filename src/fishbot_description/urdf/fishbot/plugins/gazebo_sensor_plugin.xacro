<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_sensor_plugin">
        
        <!-- ========================================== -->
        <!-- 1. 激光雷达 (Lidar) -->
        <!-- ========================================== -->
        <gazebo reference="laser_link">
            <!-- 类型推荐用 gpu_lidar，性能更好 -->
            <sensor name="laserscan" type="gpu_lidar">
                <topic>scan</topic> <!-- Gazebo 内部话题名 -->
                <update_rate>20</update_rate>
                <visualize>true</visualize>
                <always_on>true</always_on>
                
                <!-- 【新增】强制指定 ROS 里的坐标系名称 -->
                <gz_frame_id>laser_link</gz_frame_id>

                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>0.000000</min_angle>
                            <max_angle>6.280000</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.120000</min>
                        <max>8.0</max>
                        <resolution>0.015000</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>

        <!-- ========================================== -->
        <!-- 2. IMU 传感器 (本次新增) -->
        <!-- ========================================== -->
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <topic>imu</topic>  <!-- Gazebo 内部话题名 -->
                <update_rate>100</update_rate>
                <always_on>true</always_on>
                
                <!-- 强制指定 ROS 坐标系，防止 RViz 报错 -->
                <gz_frame_id>imu_link</gz_frame_id>

                <!-- IMU 专用插件 (它不涉及渲染，放这里是安全的) -->
                
                <!-- 这里的噪声参数我完全照搬了你提供的数值 -->
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

        <!-- 3. 深度相机 (修改类型) -->
        <gazebo reference="camera_link">
            <!-- 【关键修改】把 type="depth_camera" 改为 type="rgbd_camera" -->
            <!-- rgbd_camera 会同时生成彩色图和深度图 -->
            <sensor name="camera_sensor" type="rgbd_camera">
                <topic>camera</topic> <!-- 话题前缀 -->
                <update_rate>10</update_rate>
                <always_on>true</always_on>
                
                <!-- 关键：强制指定ROS消息的Frame ID为光学坐标系 -->
                <!-- 这样点云才能在RViz里正确朝向前方 -->
                <gz_frame_id>camera_link</gz_frame_id>

                <camera name="camera">
                    <horizontal_fov>1.5009831567</horizontal_fov>
                    <image>
                        <!-- 【修改 1】使用标准 VGA 分辨率，避免内存对齐问题 -->
                        <width>640</width>
                        <height>480</height>
                        <!-- 【修改 2】使用更标准的格式字符串 -->
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>10.0</far>
                    </clip>
                    <distortion>
                        <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
                        <p1>0.0</p1><p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                    <!-- Gazebo内部的光学帧配置 -->
                    <optical_frame_id>camera_link</optical_frame_id>
                </camera>
                
            </sensor>
        </gazebo>

        <!-- ========================================== -->
        <!-- 4. 全局传感器插件 (管理雷达/相机渲染) -->
        <!-- ========================================== -->


    </xacro:macro>
</robot>