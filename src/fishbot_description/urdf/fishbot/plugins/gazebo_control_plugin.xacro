<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_control_plugin">
        <gazebo>
            
            <!-- 新版差速驱动插件 -->
            <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
                
                <!-- 关节名称 (需要和你 urdf 里定义的 joint name 一致) -->
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>

                <!-- 几何参数 -->
                <wheel_separation>0.2</wheel_separation>
                <wheel_radius>0.032</wheel_radius> <!-- 注意：这里是半径，书里直径0.064，这里要除以2 -->

                <!-- 限制 (可选) -->
                <max_linear_acceleration>1</max_linear_acceleration>
                <min_linear_acceleration>-1</min_linear_acceleration>
                <max_angular_acceleration>2</max_angular_acceleration>
                <min_angular_acceleration>-2</min_angular_acceleration>
                <max_linear_velocity>0.5</max_linear_velocity>
                <min_linear_velocity>-0.5</min_linear_velocity>
                <max_angular_velocity>1</max_angular_velocity>
                <min_angular_velocity>-1</min_angular_velocity>

                <!-- 话题设置 -->
                <topic>cmd_vel</topic>           <!-- Gazebo 监听的速度指令话题 -->
                <odom_topic>odom</odom_topic>    <!-- Gazebo 发布的里程计话题 -->
                <tf_topic>tf</tf_topic>          <!-- Gazebo 发布的 TF -->
                <frame_id>odom</frame_id>
                <child_frame_id>base_footprint</child_frame_id>
                <odom_publish_frequency>30</odom_publish_frequency>
            </plugin>

            <!-- 2. 【新增】关节状态发布插件 -->
            <!-- 这个插件会读取所有关节(joint)的角度，发送到 Gazebo 内部的 "joint_states" 话题 -->
            <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
                <topic>joint_states</topic> <!-- 显式指定话题名 -->
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>